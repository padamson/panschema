/target/
# wasm-pack writes to panschema-viz/target/ — build.rs sets
# CARGO_TARGET_DIR there so the recursive cargo invocation doesn't
# fight the outer cargo for the workspace target lock.
/panschema-viz/target/
/output/
examples/**/output/
examples/**/docs/
examples/**/index.html
examples/**/panschema_viz.*
**/*.rs.bk
.DS_Store
typos.toml
.env

# cargo-mutants output (local runs leave these; CI uploads as artifact)
/mutants.out/
/mutants.out.old/
panschema/viz-bundle/

# Managed agent skills, materialized by `npx skills add`. The pin lives in
# skills-lock.json (committed); the content is fetched, so it is not vendored
# here. The Claude Code entry point is a symlink into .agents/, so tracking it
# would leave a dangling link in any clone that has not run the install.
# panschema's own skill lives in skills/ and is never installed here, so no
# negation is needed.
.agents/
.claude/skills/

# Claude Code. The sandbox block is tracked in .claude/settings.json so every
# clone gets the same one; personal permission allowlists and local state are
# not, and must not be committed by a clone whose user-level ignore file
# doesn't already cover them.
.claude/settings.local.json
.claude/.cc-writes/
.claude/scheduled_tasks.lock
